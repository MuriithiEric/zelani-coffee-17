NODE_ENV=development

PORT=3000

# Connection string to local PostgreSQL database
DATABASE_URL="postgresql://zelani_user:securePassword123@localhost:5432/zelani_coffee_db?schema=public"

# JWT Config
JWT_SECRET=change-me-secret-key-xyz-123-abc-456
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-key-xyz-123-abc-456
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# Allowed CORS origins
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:8081,zelanicoffee.com, www.zelanicoffee.com, https://zelanicoffee.com,http://zelanicoffee.com

# DHL API Integration Credentials
DHL_USERNAME=dhl_test_user
DHL_PASSWORD=dhl_test_password

# Enable Swagger API docs
ENABLE_SWAGGER=true